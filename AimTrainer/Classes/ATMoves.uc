//=============================================================================
// ATMoves - library of real player movement clips (AimTrainerMoves.ini).
//
// Generated by AimTrainer\Tools\make_clips.py from demos recorded with
// ATRecorder. Each clip is a string of samples at SampleRate per second,
// 4 characters per sample:
//   state   w = walking, a = in the air, j = jump starts here, d = dodge starts here
//   F       velocity towards the opponent
//   R       velocity to the opponent's side
//   Z       vertical launch velocity (jump/dodge samples)
// Velocities use the Alphabet: index 40 = 0, one step = 25 uu/s.
// Clips are grouped by pattern (CatStart/CatCount): 0 long strafes / circle
// strafes, 1 ADAD, 2 mixed, 3 dodge-heavy. Targets pick a pattern by
// CatWeight, never the same one twice in a row, then a random clip in it.
//=============================================================================
class ATMoves extends Object config(AimTrainerMoves);

var config float  SampleRate;
var config string Source;          // how the clips were made (for information)
var config string Clip[3000];
var config int    CatStart[4], CatCount[4];
var float CatWeight[4];
var int NumClips;

var string Alphabet;

function Init()
{
	NumClips = 0;
	while ( NumClips < ArrayCount(Clip) && Clip[NumClips] != "" )
		NumClips++;
	if ( SampleRate <= 0 )
		SampleRate = 20;
}

// A random clip index, of a different pattern than LastCat. Cat returns its pattern.
function int PickClip( int LastCat, out int Cat )
{
	local int k;
	local float Total, R;

	if ( CatCount[0] + CatCount[1] + CatCount[2] + CatCount[3] <= 0 )
	{
		// a library without patterns: any clip
		Cat = -1;
		return Rand(NumClips);
	}
	for ( k = 0; k < 4; k++ )
		if ( k != LastCat && CatCount[k] > 0 )
			Total += CatWeight[k];
	if ( Total <= 0 )
		LastCat = -1;
	R = FRand() * Total;
	for ( k = 0; k < 4; k++ )
	{
		if ( k == LastCat || CatCount[k] <= 0 )
			continue;
		R -= CatWeight[k];
		if ( R <= 0 )
			break;
	}
	k = Min(k, 3);
	if ( CatCount[k] <= 0 )
	{
		Cat = -1;
		return Rand(NumClips);
	}
	Cat = k;
	return Clamp(CatStart[k] + Rand(CatCount[k]), 0, NumClips - 1);
}

function float Val( string Ch )
{
	local int i;
	i = InStr(Alphabet, Ch);
	if ( i < 0 )
		return 0;
	return (i - 40) * 25.0;
}

defaultproperties
{
	SampleRate=20
	CatWeight(0)=0.35
	CatWeight(1)=0.30
	CatWeight(2)=0.20
	CatWeight(3)=0.15
	Alphabet="0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz!#$%&()*+,-./:<>?@[]^_{|}~"
}
